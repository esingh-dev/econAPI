# ==============================================================================
# econAPI Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env

# Application Environment: 'development' (bypasses auth) or 'production' (enforces API key)
ECONAPI_ENVIRONMENT=development

# Application Metadata
ECONAPI_APP_NAME="econAPI"
ECONAPI_VERSION="1.0.0"

# Server Network Binding
ECONAPI_HOST=0.0.0.0
ECONAPI_PORT=8000

# Allowed CORS Origins (JSON list format)
ECONAPI_CORS_ORIGINS=["*"]

# Valid API Keys (active when ECONAPI_ENVIRONMENT=production)
# Format as JSON list: ["key-1", "key-2"]
ECONAPI_VALID_API_KEYS=["test-dev-key-12345"]
